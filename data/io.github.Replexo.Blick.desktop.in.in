[Desktop Entry]
Name=Blick
GenericName=Image Viewer and Video Player
Comment=View and edit images and videos
Exec=@BIN_NAME@ %U
Icon=@APP_ID@
DBusActivatable=true
Terminal=false
Type=Application
Categories=GNOME;GTK;Graphics;2DGraphics;RasterGraphics;Viewer;
MimeType=@MIME_TYPES@
Keywords=Picture;Graphics;Loupe;Blick;Video;Movie;
StartupNotify=true
X-Purism-FormFactor=Workstation;Mobile;
# Flatpak moves Glance's settings and data over to Blick
X-Flatpak-RenamedFrom=io.github.Replexo.Glance.desktop;
