<?xml version="1.0" encoding="utf-8"?>
<schemalist>
  <schema path="/io/github/Replexo/Blick/" id="@app-id@" gettext-domain="@gettext-package@">
    <key name="show-properties" type="b">
      <default>false</default>
      <summary>Show the image properties sidebar</summary>
    </key>
    <key name="made-default" type="b">
      <default>false</default>
      <summary>Blick made itself the default for images and videos on its first start</summary>
    </key>
    <key name="update-reminder" type="x">
      <default>0</default>
      <summary>When to tell about a new release again, in seconds since 1970</summary>
    </key>
    <key name="autoplay-next" type="b">
      <default>false</default>
      <summary>Play the next video in the folder when one ends</summary>
    </key>
  </schema>
</schemalist>
