<?xml version="1.0" encoding="utf-8"?>
<schemalist>
  <schema path="/io/github/Replexo/Blink/" id="@app-id@" gettext-domain="@gettext-package@">
    <key name="show-properties" type="b">
      <default>false</default>
      <summary>Show the image properties sidebar</summary>
    </key>
    <key name="autoplay-next" type="b">
      <default>false</default>
      <summary>Play the next video in the folder when one ends</summary>
    </key>
    <key name="opensubtitles-username" type="s">
      <default>""</default>
      <summary>OpenSubtitles username; the password is kept in the keyring</summary>
    </key>
    <key name="subtitle-language" type="s">
      <default>""</default>
      <summary>Language of online subtitle searches, empty for the system language</summary>
    </key>
  </schema>
</schemalist>
